# GEMINI_API_KEY: Required for Gemini AI API calls (AI Advisor + recommend).
# Without it, /api/recommend-model falls back to heuristics and /api/advisor 503s.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HUGGINGFACE_API_KEY: (Recommended) raises Hub rate limits for model refresh.
# Without it the refresh still works with anonymous (lower) limits.
HUGGINGFACE_API_KEY=""

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# In production: https://<your-app>.onrender.com
APP_URL="http://localhost:3000"

# PORT: HTTP port the server listens on. Render injects its own; 3000 locally.
PORT=3000

# DATABASE_URL: PostgreSQL connection string.
# Example: postgres://llmcalc:password@localhost:5432/llmcalc
DATABASE_URL="postgres://llmcalc:password@localhost:5432/llmcalc"

# Google OAuth 2.0 credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
# Must match the "Authorized redirect URIs" configured in Google Cloud Console.
# Example: http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# SESSION_SECRET: Random string used to sign the session JWT cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ADMIN_EMAILS: Comma-separated Google emails allowed to trigger the on-demand
# catalog refreshes (POST /api/models/refresh, POST /api/gpu-prices/refresh).
ADMIN_EMAILS="you@example.com"