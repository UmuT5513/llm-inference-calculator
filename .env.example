# GEMINI_API_KEY: Required for Gemini AI API calls (AI Advisor + recommend).
# Without it, /api/recommend-model falls back to heuristics and /api/advisor 503s.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HUGGINGFACE_API_KEY: (Recommended) raises Hub rate limits for model refresh.
# Without it the refresh still works with anonymous (lower) limits.
HUGGINGFACE_API_KEY=""

# APP_URL: The URL where this app is hosted.
# Used for self-referential links and API endpoints.
APP_URL="http://localhost:3000"

# PORT: HTTP port the server listens on. Render injects its own; 3000 locally.
PORT=3000

# DATABASE_URL: PostgreSQL connection string.
# Example: postgres://llmcalc:password@localhost:5432/llmcalc
# Docker Compose: overridden automatically (postgres://llmcalc:$POSTGRES_PASSWORD@db:5432/llmcalc?sslmode=disable).
# NOTE: hosts other than localhost get SSL auto-enabled unless ?sslmode= is present —
# the compose "db" container has no SSL, so keep ?sslmode=disable there.
DATABASE_URL="postgres://llmcalc:password@localhost:5432/llmcalc"

# Docker Compose only: Postgres password for the "db" container.
POSTGRES_PASSWORD="change-me-strong-password"

# Host nginx only (not read by Docker Compose): public domain for the TLS site.
# TLS is issued on the host via certbot for the nginx server_name
# (site: /etc/nginx/sites-available/llminferencecalc.com.tr), which reverse-proxies
# to 127.0.0.1:8081 where the app publishes.
DOMAIN="example.com"

# SESSION_SECRET: Random string used to sign the admin session JWT cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Local admin login (Yönetim paneli) credentials. Both must be set to enable it.
# The admin session also guards the on-demand catalog refreshes
# (POST /api/models/refresh, POST /api/gpu-prices/refresh).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

